# Mac Docker Desktop proxy-only smoke test
OMLX_BACKEND_URL=http://host.docker.internal:11434/v1
OMLX_PROXY_PORT=8080
OMLX_PROXY_API_KEY=
OMLX_CONTEXT_SCALING=false
OMLX_TARGET_CONTEXT_SIZE=200000
OMLX_ACTUAL_CONTEXT_SIZE=8192
OMLX_SSE_KEEPALIVE_MODE=ping
OMLX_PROXY_STATE_PATH=/data/proxy-state.json

# Linux / NVIDIA vLLM sidecar
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_MODEL=Qwen/Qwen3-1.7B
VLLM_SERVED_MODEL_NAME=qwen
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_MAX_NUM_SEQS=4
VLLM_HF_HOME=${HOME}/.cache/huggingface
VLLM_GENERATION_CONFIG=vllm
VLLM_DEFAULT_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}
VLLM_TRUST_REMOTE_CODE=true
VLLM_ENFORCE_EAGER=false
VLLM_ENABLE_AUTO_TOOL_CHOICE=false
VLLM_TOOL_CALL_PARSER=hermes
VLLM_REASONING_PARSER=
HF_TOKEN=
